generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== 用户扩展（与主站 User 表关联） ==========
model AtcUser {
  id         Int      @id @default(autoincrement())
  cid        String   @unique          // 对应主站 User.cid
  rating     Int      @default(0)      // 管制等级
  instructor String   @default("")     // 分配的教员 CID
  totalHours Float    @default(0)      // 在线管制总时长（小时）
  joinDate   DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ========== 文章管理 ==========
model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  summary   String   @default("")
  category  String   @default("")     // guide/sop/training
  authorCid String   @default("")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 视频管理 ==========
model Video {
  id          Int      @id @default(autoincrement())
  title       String
  url         String                   // 视频链接
  description String   @default("")
  category    String   @default("")
  duration    Int      @default(0)     // 秒
  authorCid   String   @default("")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========== 题库管理 ==========
model Question {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text         // 题目内容
  options    String   @default("[]")   // JSON: ["A. xxx","B. xxx","C. xxx","D. xxx"]
  answer     String                   // 正确答案
  category   String   @default("")     // 分类
  difficulty Int      @default(1)      // 1-5
  explain    String   @default("")     // 解析
  authorCid  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ========== 考试管理 ==========
model Exam {
  id             Int      @id @default(autoincrement())
  title          String
  description    String   @default("")
  questionIds    String   @default("[]")  // JSON: [1,2,3,...]
  passingScore   Int      @default(70)
  duration       Int      @default(60)    // 分钟
  category       String   @default("")
  published      Boolean  @default(false)
  createdBy      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ========== 考试记录 ==========
model ExamAttempt {
  id          Int      @id @default(autoincrement())
  examId      Int
  cid         String
  answers     String   @default("[]")  // JSON: [{qId, answer, correct}]
  score       Int      @default(0)
  total       Int      @default(0)
  passed      Boolean  @default(false)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
}

// ========== 模拟机预约 ==========
model SimSession {
  id            Int      @id @default(autoincrement())
  cid           String                   // 预约人 CID
  type          String   @default("training") // training / exam
  title         String   @default("")
  startTime     DateTime
  endTime       DateTime?
  note          String   @default("")     // 备注
  scope         String   @default("all")  // all /指定教员
  instructorCid String   @default("")     // 指定教员 CID（scope=指定教员时）
  status        String   @default("pending") // pending / approved / completed / cancelled
  reviewerCid   String   @default("")     // 审核人
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ========== 上管上报 ==========
model Report {
  id             Int      @id @default(autoincrement())
  cid            String                   // 上报人 CID
  name           String   @default("")     // 上报人姓名
  instructorCid  String   @default("")     // 教员 CID
  instructorName String   @default("")     // 教员姓名
  position       String   @default("")     // 上管席位
  note           String   @default("")     // 备注
  durationMin    Int      @default(0)      // 上管时长（分钟）
  status         String   @default("pending") // pending / approved / rejected
  reviewerCid    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ========== 教员申请 ==========
model InstructorApplication {
  id          Int      @id @default(autoincrement())
  cid         String                   // 申请人 CID
  name        String   @default("")     // 申请人姓名
  targetCid   String                   // 目标教员 CID
  status      String   @default("pending") // pending / approved / rejected
  reviewerCid String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========== 管制排班 ==========
model Schedule {
  id         Int      @id @default(autoincrement())
  cid        String                   // 管制员 CID
  date       DateTime                 // 排班日期
  position   String                   // 席位: GROUND / TOWER / APPROACH / CENTER
  startTime  DateTime                 // 开始时间
  endTime    DateTime                 // 结束时间
  status     String   @default("scheduled") // scheduled / working / completed / cancelled
  note       String   @default("")
  createdBy  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
